{
  // koelony.com: the static site, with a tiny Worker in front that sends www to the bare domain.
  // Deploy: `bun run deploy`, or connect this repo in Workers Builds (build: `bun run build`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koelony-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only www needs the Worker; on koelony.com itself it just hands the request to the assets.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "koelony.com", "custom_domain": true },
    { "pattern": "www.koelony.com", "custom_domain": true }
  ]
}
