{
  // Static site on Cloudflare Workers (static assets only, no Worker script).
  // Deploy: `bun run deploy`, or connect this repo in Workers Builds (build: `bun run build`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koelony-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "koelony.com", "custom_domain": true },
    { "pattern": "www.koelony.com", "custom_domain": true }
  ]
}
