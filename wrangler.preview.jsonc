{
  // Always-on preview of the site at https://koelony-preview.<account>.workers.dev.
  // No routes, so it can never take over koelony.com. Deploy: `bun run deploy:preview`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koelony-preview",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
